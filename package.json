{
  "name": "then-and-now",
  "version": "0.2.0-alpha.0",
  "private": true,
  "description": "A private recurring ritual where two people trade one meaningful story at a time.",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:test": "supabase test db",
    "db:types": "sh scripts/generate-database-types.sh",
    "db:types:check": "sh scripts/check-database-types.sh"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/dm-serif-display": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.8",
    "@radix-ui/react-dialog": "^1.1.15",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.4",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "supabase": "^2.39.2",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
