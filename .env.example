# Runtime boundary: local | preview | staging | production
APP_ENV=local
# Database boundary: local | staging | production
DATA_ENV=local

# Public application origin. Use a distinct URL for every environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase publishes these values for browser-safe, RLS-scoped access.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only provider credentials. Leave blank until each integration is enabled.
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
DUB_API_KEY=
SENTRY_DSN=

# Never set a preview deployment to DATA_ENV=production.
